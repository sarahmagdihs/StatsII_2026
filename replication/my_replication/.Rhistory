EUIntegrationSelf8
table(merge$EUIntegrationSelf8, useNA = "ifany")
#party ID strength added to model
defection_id <- lm(data= merge, partyswitcher~EUIntegrationSelf8 *Conchange + as.factor(partyIdStrength_extension) + age.x + gender.x + white + as.factor(country.x))
summary(defection_id)
# Predict
newdata$pred <- predict(defection_id, newdata)
library(ggplot2)
# Create prediction grid
newdata <- expand.grid(
EUIntegrationSelf8 = seq(min(merge$EUIntegrationSelf8, na.rm=TRUE),
max(merge$EUIntegrationSelf8, na.rm=TRUE), length.out=50),
Conchange = c(-2, 0, 2),  # low / no change / high change
partyIdStrength_extension = c("Strong", "Fairly strong", "Not very strong"),
age.x = mean(merge$age.x, na.rm=TRUE),
gender.x = "Male",
white = 1,
country.x = "England"
)
# Predict
newdata$pred <- predict(defection_id, newdata)
table(merge$EUIntegrationSelf8, useNA = "ifany")
ggplot(merge, aes(x = EUIntegrationSelf8, y = partyswitcher,
color = partyIdStrength_extension)) +
geom_smooth(method = "glm", method.args = list(family = "binomial")) +
theme_minimal()
summary(defection_id)
